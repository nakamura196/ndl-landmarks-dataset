{
  "profile": "tabular-data-package",
  "name": "ndl-landmarks",
  "id": "https://doi.org/10.5281/zenodo.21501348",
  "version": "1.0.2",
  "doi": "10.5281/zenodo.21501348",
  "created": "2026-07-23",
  "title": "錦絵と写真でめぐる日本の名所（データセット）",
  "description": "国立国会図書館の電子展示会「錦絵と写真でめぐる日本の名所」の公開ページから機械的に抽出し、地図データ形式へ変換・整形した非公式の二次データセット (国立国会図書館が作成・公認したものではない)。名所(緯度経度付き)と、各名所に紐づく江戸〜明治大正期の錦絵・写真(NDLデジタルコレクション由来)の一覧。\nライセンスは3層に分かれる: 編纂データ(座標・分類・構造)は CC BY 4.0 / 画像は各行の rights を参照 / sights の description 列は国立国会図書館の著作物であり CC BY 4.0 の対象外 (© 国立国会図書館)。",
  "homepage": "https://github.com/nakamura196/ndl-landmarks-dataset",
  "keywords": [
    "National Diet Library",
    "IIIF",
    "GeoJSON",
    "digital humanities",
    "meisho",
    "ukiyo-e",
    "Japan",
    "open data"
  ],
  "licenses": [
    {
      "name": "CC-BY-4.0",
      "title": "Creative Commons Attribution 4.0 (編纂データ)",
      "path": "https://creativecommons.org/licenses/by/4.0/"
    }
  ],
  "contributors": [
    {
      "title": "Satoru Nakamura",
      "role": "author"
    }
  ],
  "sources": [
    {
      "title": "国立国会図書館「錦絵と写真でめぐる日本の名所」",
      "path": "https://www.ndl.go.jp/landmarks"
    }
  ],
  "resources": [
    {
      "name": "sights",
      "path": "sights.csv",
      "profile": "tabular-data-resource",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "dialect": {
        "delimiter": ",",
        "lineTerminator": "\r\n",
        "quoteChar": "\""
      },
      "schema": {
        "primaryKey": [
          "slug"
        ],
        "fields": [
          {
            "name": "slug",
            "type": "string",
            "description": "名所の一意識別子 (URL slug)"
          },
          {
            "name": "title",
            "type": "string",
            "description": "名所名"
          },
          {
            "name": "prefecture",
            "type": "string",
            "description": "都道府県 (県境の名所は主たる1県)"
          },
          {
            "name": "region",
            "type": "string",
            "description": "地方区分 (北海道/東北/関東/中部/近畿/中国/四国/九州)"
          },
          {
            "name": "lat",
            "type": "number",
            "description": "緯度 (WGS84)"
          },
          {
            "name": "lng",
            "type": "number",
            "description": "経度 (WGS84)"
          },
          {
            "name": "zoom",
            "type": "integer",
            "description": "推奨地図ズーム"
          },
          {
            "name": "image_count",
            "type": "integer",
            "description": "紐づく画像点数"
          },
          {
            "name": "other_material_count",
            "type": "integer",
            "description": "その他の資料 (書物参照) 件数"
          },
          {
            "name": "description",
            "type": "string",
            "description": "解説。国立国会図書館の著作物 (© NDL) であり CC BY 4.0 の対象外。"
          },
          {
            "name": "description_rights",
            "type": "string",
            "description": "解説文の権利表示"
          },
          {
            "name": "source_url",
            "type": "string",
            "format": "uri",
            "description": "出典 (NDL 名所ページ)"
          }
        ]
      }
    },
    {
      "name": "images",
      "path": "images.csv",
      "profile": "tabular-data-resource",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "dialect": {
        "delimiter": ",",
        "lineTerminator": "\r\n",
        "quoteChar": "\""
      },
      "schema": {
        "foreignKeys": [
          {
            "fields": [
              "sight_slug"
            ],
            "reference": {
              "resource": "sights",
              "fields": [
                "slug"
              ]
            }
          }
        ],
        "fields": [
          {
            "name": "sight_slug",
            "type": "string",
