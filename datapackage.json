          {
            "name": "sight_title",
            "type": "string",
            "description": "名所名"
          },
          {
            "name": "prefecture",
            "type": "string",
            "description": "都道府県"
          },
          {
            "name": "region",
            "type": "string",
            "description": "地方区分"
          },
          {
            "name": "category",
            "type": "string",
            "description": "種別 (錦絵・絵画等 / 写真)"
          },
          {
            "name": "caption",
            "type": "string",
            "description": "図版キャプション (原資料の題)"
          },
          {
            "name": "pid",
            "type": "string",
            "description": "NDLデジタルコレクション PID"
          },
          {
            "name": "bib",
            "type": "string",
            "description": "書誌ID"
          },
          {
            "name": "book_title",
            "type": "string",
            "description": "書物タイトル (IIIF manifest 由来。空欄あり)"
          },
          {
            "name": "author",
            "type": "string",
            "description": "著者/絵師"
          },
          {
            "name": "series",
            "type": "string",
            "description": "シリーズ名"
          },
          {
            "name": "rights",
            "type": "string",
            "description": "権利表示 (NDL Access Restrictions)。PDM=パブリックドメイン。空欄は IIIF manifest が無く未確認であることを示す (パブリックドメインを意味しない)。"
          },
          {
            "name": "rights_url",
            "type": "string",
            "format": "uri",
            "description": "権利表示の URL (PDM のみ)"
          },
          {
            "name": "iiif_image_url",
            "type": "string",
